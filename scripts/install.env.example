# Acceleratio installer configuration.
#
# Copy this file, adjust the values you need, then run:
#   sudo ./scripts/install.sh --config ./install.env
#
# The file is sourced as shell syntax. Keep it readable only by root if you add
# anything sensitive; none of the defaults below are secrets.

# k3s -----------------------------------------------------------------------
# Empty K3S_VERSION means "latest from K3S_CHANNEL".
K3S_VERSION="v1.36.5+k3s1"
K3S_CHANNEL="stable"

# Leave empty to detect the primary interface IPv4.
# K3S_NODE_IP="192.0.2.10"
# K3S_NODE_NAME="k3s-master-1"

# "auto" detects the public IPv4; set it explicitly if detection is blocked.
K3S_PUBLIC_IP="auto"

K3S_CLUSTER_CIDR="10.42.0.0/16"
K3S_SERVICE_CIDR="10.43.0.0/16"

# Daily etcd snapshots. Set to "" to disable.
K3S_ETCD_SNAPSHOT_CRON="0 3 * * *"

# Components -----------------------------------------------------------------
CILIUM_VERSION="1.20.4"

# k3s 1.36 uses the standard CNI paths. Override only if the container runtime
# reports different paths in `k3s crictl info`.
CILIUM_CNI_CONF_PATH="/etc/cni/net.d"
CILIUM_CNI_BIN_PATH="/opt/cni/bin"

HELM_VERSION="3.18.0"

# VictoriaMetrics (project Observability) -------------------------------------
VICTORIAMETRICS_CHART_VERSION="0.50.0"
VICTORIAMETRICS_RETENTION="14d"
# Metrics data is node-local and kept off the storage layer.
VICTORIAMETRICS_DATA_DIR="/var/lib/victoria-metrics"

# VictoriaLogs + Vector (project Logs) ----------------------------------------
VICTORIALOGS_CHART_VERSION="0.13.11"
VICTORIALOGS_RETENTION="7d"
# Logs beyond this size are dropped oldest-first, before the retention ends.
VICTORIALOGS_MAX_DISK="2GiB"
# Log data is node-local and kept off the storage layer.
VICTORIALOGS_DATA_DIR="/var/lib/victoria-logs"

# Storage (Longhorn) ---------------------------------------------------------
# longhorn on servers; local-path only for machines that cannot run Longhorn
# (LXC/OpenVZ containers).
STORAGE_BACKEND="longhorn"
LONGHORN_CHART_VERSION="1.13.0"
LONGHORN_NAMESPACE="longhorn-system"
LONGHORN_RELEASE="longhorn"
# Volume data. Use a dedicated disk for production.
LONGHORN_DATA_DIR="/var/lib/longhorn"
# Copies of every platform volume, each on a different server (1-3). More
# than 1 needs as many servers and a fast network between them.
LONGHORN_REPLICAS="1"
# Default StorageClass: longhorn (local-path with STORAGE_BACKEND=local-path).
STORAGE_CLASS_NAME="longhorn"

# Object storage (RustFS) ----------------------------------------------------
RUSTFS_NAMESPACE="rustfs"
# One volume holds all S3 data: buckets, PostgreSQL backups and site files.
RUSTFS_SIZE="50Gi"
# Admin keys are written to /etc/acceleratio/rustfs-s3.env.

# Acceleratio ----------------------------------------------------------------
# PostgreSQL, the API and the console run in this namespace.
ACCELERATIO_NAMESPACE="acceleratio"

# Image tag for the API and the console.
ACCELERATIO_VERSION="0.3.1"
# ACCELERATIO_API_IMAGE="ghcr.io/acceleratio-cloud/api:0.3.1"
# ACCELERATIO_CONSOLE_IMAGE="ghcr.io/acceleratio-cloud/console:0.3.1"
POSTGRES_IMAGE="postgres:17-alpine"

# The database is stored on the server's own disk.
POSTGRES_DATA_DIR="/var/lib/acceleratio/postgres"

# The dashboard and API are published on these node ports (30000-32767).
ACCELERATIO_CONSOLE_NODE_PORT="30300"
ACCELERATIO_API_NODE_PORT="30080"

# Development server (same as --dev): no API and console; PostgreSQL and
# RustFS S3 are published on these node ports for an API run from source.
# ACCELERATIO_DEV="1"
# ACCELERATIO_POSTGRES_NODE_PORT="30432"
# RUSTFS_NODE_PORT="30900"

# URLs use the public IPv4 by default. Set a host name, or full URLs when a
# domain or reverse proxy sits in front. Both URLs must be reachable from the
# browser.
# ACCELERATIO_PUBLIC_HOST="cloud.example.com"
# ACCELERATIO_CONSOLE_URL="https://console.example.com"
# ACCELERATIO_API_URL="https://api.example.com"

# Contact address Let's Encrypt uses for expiry notices when you set a custom
# domain in Console -> Settings -> System. Optional; leave empty to register
# without one.
# ACCELERATIO_ACME_EMAIL="ops@example.com"

# Host -----------------------------------------------------------------------
# Generated values, kubeconfig and S3 credentials.
CONFIG_DIR="/etc/acceleratio"

# Installer logs.
LOG_DIR="/var/log/acceleratio"

# kubelet requires swap off. Set to 1 only if you know what you are doing.
ALLOW_SWAP="0"
