# Base URL of the core API. Must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080
# In containers, set these at runtime instead (they win over the value above):
# API_URL=https://api.example.com          # browser-facing API URL
# API_INTERNAL_URL=http://api.svc:8080     # optional, server-side calls only
