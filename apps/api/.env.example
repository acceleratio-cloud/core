# HTTP
PORT=8080

# Better Auth
BETTER_AUTH_URL=http://localhost:8080
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# PostgreSQL (the local service in docker-compose.yml listens on host port 5433)
DATABASE_URL=postgresql://acceleratio:acceleratio@localhost:5433/acceleratio

# Kubernetes (optional).
# When unset, the API uses your current kubeconfig context (~/.kube/config) or
# the in-cluster service account. Local development must only target a
# disposable cluster; set this explicitly to avoid using an ambient context.
# Accepts a path to a kubeconfig file or the YAML contents themselves. An
# exported shell KUBECONFIG takes precedence over this value, and a leading ~
# in a path is expanded. In .env use \n for line breaks inside a double-quoted
# inline value:
# KUBECONFIG=/absolute/path/to/kubeconfig
# KUBECONFIG="<kubeconfig YAML contents>"

# Comma-separated list of origins allowed to send credentialed requests. The
# control plane URL applied in Settings → System is trusted in addition.
CORS_ORIGINS=http://localhost:3000

# Control plane URL (Settings → System). The public IPv4 address the domain's
# A record must point to; the installer sets it. Without it the API uses a
# node ExternalIP. DNS_RESOLVERS overrides the resolvers used for the check.
# ACCELERATIO_PUBLIC_IP=203.0.113.10
# DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Workload observer (cluster-wide watch; set to false to disable)
WORKLOAD_OBSERVER_ENABLED=true
# Full resync interval in milliseconds
WORKLOAD_OBSERVER_RESYNC_MS=60000
