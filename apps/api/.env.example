# HTTP
PORT=8080

# Better Auth
BETTER_AUTH_URL=http://localhost:8080
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# Encrypts integration credentials (GitHub App private keys) stored in the
# database. Generate once with `openssl rand -base64 32` and never change it:
# existing credentials become unreadable. Keep it out of the database.
INTEGRATIONS_ENCRYPTION_KEY=replace-me-with-a-32-byte-random-secret

# API address used in the GitHub App's redirect and webhook URLs. Unset in
# production: the control plane URL plus /api, else BETTER_AUTH_URL, is used.
# Redirects go through your browser and work on any address; GitHub can only
# deliver webhooks (uninstall and suspend events) to an HTTPS one. For those in
# local development, tunnel the API (port 8080), for example
# `ngrok http --url=<your-static-domain> 8080`, then:
# GITHUB_CALLBACK_BASE_URL=https://<your-static-domain>

# PostgreSQL. For local development, the value `scripts/install.sh --dev`
# prints: the development server's database on node port 30432.
DATABASE_URL=postgresql://acceleratio:<password>@<dev-server>:30432/acceleratio

# Kubernetes (optional).
# For local development, the development server's kubeconfig
# (/etc/acceleratio/kubeconfig.yaml on the server). Local development must only
# target your own development server, never a shared or production cluster.
# Accepts a path to a kubeconfig file or the YAML contents themselves. An
# exported shell KUBECONFIG takes precedence over this value, and a leading ~
# in a path is expanded. In .env use \n for line breaks inside a double-quoted
# inline value:
# KUBECONFIG=/absolute/path/to/kubeconfig
# KUBECONFIG="<kubeconfig YAML contents>"

# Comma-separated list of origins allowed to send credentialed requests. The
# control plane URL applied in Settings → System is trusted in addition.
CORS_ORIGINS=http://localhost:3000

# Control plane URL (Settings → System). The public IPv4 address the domain's
# A record must point to; the installer sets it. Without it the API uses a
# node ExternalIP. `scripts/install.sh --dev` prints it. DNS_RESOLVERS overrides the resolvers used for the check.
# ACCELERATIO_PUBLIC_IP=203.0.113.10
# DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Workload observer (cluster-wide watch; set to false to disable)
WORKLOAD_OBSERVER_ENABLED=true
# Full resync interval in milliseconds
WORKLOAD_OBSERVER_RESYNC_MS=60000
# Deletes Docker volume claims no service config needs, at start and every
# 10 minutes (set to false to disable)
VOLUME_SWEEP_ENABLED=true

# VictoriaMetrics Service (`name.namespace:port`) behind the project
# Observability tab, reached through the API server's service proxy. The
# default matches scripts/install.sh.
# VICTORIAMETRICS_ADDRESS=victoria-metrics.victoria-metrics:8428

# VictoriaLogs Service (`name.namespace:port`) behind the project Logs tab,
# reached through the API server's service proxy. Vector ships the project
# containers' logs into it. The default matches scripts/install.sh.
# VICTORIALOGS_ADDRESS=victoria-logs.victoria-logs:9428

# Storage. RustFS serves S3 for buckets, PostgreSQL backups and static sites;
# the API reads its admin keys from the Secret RUSTFS_ADMIN_SECRET in
# RUSTFS_NAMESPACE. RUSTFS_S3_ENDPOINT is the address pods use;
# RUSTFS_S3_API_ENDPOINT is the one the API uses (for local development, the
# development server's node port 30900 that `scripts/install.sh --dev` prints).
# PLATFORM_STORAGE_CLASS_NAME is the installer's StorageClass.
# RUSTFS_NAMESPACE=rustfs
# RUSTFS_ADMIN_SECRET=rustfs-root
# RUSTFS_S3_ENDPOINT=http://rustfs.rustfs.svc.cluster.local:9000
# RUSTFS_S3_API_ENDPOINT=
# RUSTFS_RC_IMAGE=rustfs/rc:v0.1.37
# SITES_BUCKET=acceleratio-sites
# PLATFORM_STORAGE_CLASS_NAME=longhorn
# LONGHORN_NAMESPACE=longhorn-system

# Adding servers from the console (optional). The installer sets these in the
# cluster; without them the "add server" flow reports it is not configured.
# `scripts/install.sh --dev` prints them for local development.
# K3S_JOIN_URL is the API server address other nodes reach, K3S_JOIN_TOKEN the
# cluster join token (/var/lib/rancher/k3s/server/node-token). The CIDRs are
# only needed to join control-plane servers and must match the cluster.
# K3S_JOIN_URL=https://10.0.0.1:6443
# K3S_JOIN_TOKEN=
# K3S_CLUSTER_CIDR=10.42.0.0/16
# K3S_SERVICE_CIDR=10.43.0.0/16

# GitHub service builds. Jobs run rootless BuildKit in BUILD_NAMESPACE and push
# to the registry scripts/install.sh runs; nodes pull it through a mirror on its
# fixed ClusterIP (default: .50 in K3S_SERVICE_CIDR), which joined servers get
# too. The defaults match scripts/install.sh.
# BUILD_REGISTRY=registry.acceleratio.svc.cluster.local:5000
# REGISTRY_CLUSTER_IP=10.43.0.50
# BUILD_NAMESPACE=acceleratio-builds
# BUILDER_IMAGE=moby/buildkit:v0.34.2-rootless

# Platform updates from the console (Settings -> System -> Platform version).
# The release version is baked into release images; a local build reports none
# and never offers updates. Updates only run when the API runs in the cluster.
# ACCELERATIO_VERSION=0.1.6
# PLATFORM_UPDATES_ENABLED=1
# Release check interval in milliseconds (default 6 hours, 0 disables).
# PLATFORM_UPDATE_CHECK_INTERVAL_MS=21600000
# ACCELERATIO_RELEASE_REPOSITORY=acceleratio-cloud/core
# ACCELERATIO_CONFIG_DIR=/etc/acceleratio
# PLATFORM_UPDATE_ROOT=/var/lib/acceleratio/updates
