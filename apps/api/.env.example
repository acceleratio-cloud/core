# HTTP
PORT=8080

# Better Auth
BETTER_AUTH_URL=http://localhost:8080
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# PostgreSQL
DATABASE_URL=postgresql://acceleratio@localhost:5432/acceleratio

# Kubernetes (optional: kubeconfig contents, not a path; in-cluster config is used when unset)
# In .env use \n for line breaks inside the double-quoted value:
# KUBECONFIG="<kubeconfig YAML contents>"

# Comma-separated list of origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:3000
